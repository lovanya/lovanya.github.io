# Public env vars (exposed to client bundle, prefixed PUBLIC_)

# Cloudflare Worker proxy URL (via `cd worker && wrangler deploy`)
PUBLIC_WORKER_URL=https://api-proxy.<your-subdomain>.workers.dev

# Gemini API key — dev only.
# Production builds also include this var, but it's intentionally
# referrer-restricted to lovanya.github.io/* in Google AI Studio,
# so it's only effective on the live site.
# Get a key at https://aistudio.google.com/apikey
# Restrict by HTTP referrer to: lovanya.github.io/*
PUBLIC_GEMINI_API_KEY=

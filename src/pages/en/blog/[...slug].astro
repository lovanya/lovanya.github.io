---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Comments from '../../../components/Comments.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts
    .filter((post) => post.id.startsWith('en/'))
    .map((post) => ({
      params: { slug: post.id.replace('en/', '') },
      props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const title = post.data.title;
const description = post.data.description;
const tags = post.data.tags || [];
const publishedTime = post.data.pubDate.toISOString();
const modifiedTime = post.data.updatedDate?.toISOString() || publishedTime;
---

<BaseLayout
  title={title}
  description={description}
  lang="en"
  articleType="article"
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  tags={tags}
  author="Jian Lin (Ziya)"
  image={post.data.heroImage || '/images/avatar.png'}
>
  <div class="container max-w-4xl" style="padding-top: var(--space-24); padding-bottom: var(--space-24);">
    <article class="flex flex-col w-full" style="gap: var(--title-gap);">
      <!-- Back link -->
      <a
        href="/en/blog"
        class="inline-flex items-center text-[var(--color-text-secondary)] hover:text-[var(--color-accent)] transition-colors self-start"
        style="gap: var(--space-2);"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        <span class="text-sm font-mono">Back to List</span>
      </a>

      <!-- Header -->
      <header class="flex flex-col w-full" style="gap: var(--space-6);">
        {post.data.heroImage && (
          <img
            src={post.data.heroImage}
            alt={post.data.title}
            class="w-full h-64 object-cover rounded-[var(--radius)]"
          />
        )}

        <div class="flex flex-col" style="gap: var(--space-4);">
          <h1 class="text-4xl font-bold text-[var(--color-text)] leading-tight">
            {post.data.title}
          </h1>

          <div class="flex flex-wrap items-center text-sm text-[var(--color-text-secondary)] font-mono" style="gap: var(--space-3) var(--space-4);">
            <time datetime={post.data.pubDate.toISOString()}>
              Published {post.data.pubDate.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </time>
            {post.data.updatedDate && (
              <span>
                Updated {post.data.updatedDate.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </span>
            )}
          </div>
        </div>
      </header>

      <!-- Content -->
      <div class="prose prose-lg max-w-none">
        <Content />
      </div>

      <!-- Comments -->
      <Comments lang="en" />
    </article>
  </div>
</BaseLayout>

<style is:global>
  .prose h1,
  .prose h2,
  .prose h3,
  .prose h4 {
    color: var(--color-accent);
  }
</style>

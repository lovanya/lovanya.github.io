---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/Blog/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((post) => post.id.startsWith('en/'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const title = "Jian Lin Blog - Jian Lin (Ziya) Frontend Architecture / Micro-Frontend / AI Engineering";
const description = "Collection of technical blog posts by Jian Lin (also known as Ziya). Covering frontend architecture, micro-frontend, cross-platform development, performance optimization, React/Vue/Astro, TypeScript, LLM/RAG/Agent AI engineering.";

// All unique tags across all posts (for the filter bar).
const allTags = Array.from(
  new Set(posts.flatMap((post) => post.data.tags ?? [])),
).sort();

// Tag counts so the filter bar can show "(N)" next to each tag.
const tagCounts = allTags.reduce<Record<string, number>>((acc, tag) => {
  acc[tag] = posts.filter((p) => p.data.tags?.includes(tag)).length;
  return acc;
}, {});
---

<BaseLayout title={title} description={description} lang="en">
  <div class="container" style="padding-top: var(--space-24); padding-bottom: var(--space-24);">
    <div class="flex flex-col items-center" style="gap: var(--title-gap);">
      <header class="text-center flex flex-col items-center" style="gap: var(--space-3);">
        <h1 class="text-4xl font-bold text-[var(--color-text)]">Blog</h1>
        <p class="text-[var(--color-text-secondary)]">{description}</p>
      </header>

      {/* Search + tag filter controls (pure client-side filtering) */}
      <div class="w-full flex flex-col items-center" style="gap: var(--space-4);">
        {/* Search input */}
        <div class="relative w-full max-w-xl">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-4 w-4 absolute left-3 top-1/2 -translate-y-1/2 text-[var(--color-accent)] pointer-events-none"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="7" />
            <path stroke-linecap="round" d="m20 20-3.5-3.5" />
          </svg>
          <input
            id="blog-search"
            type="search"
            placeholder="Search posts by title, content, or tag…"
            aria-label="Search blog"
            class="w-full bg-[var(--color-bg-secondary)] text-sm font-mono text-[var(--color-accent)] placeholder:text-[var(--color-text-secondary)] focus:outline-none focus:ring-1 focus:ring-[var(--color-accent)]/40"
            style="height: 32px; padding: 2px 12px 2px 36px; border-radius: 4px; border: 1px solid var(--color-accent-glow);"
          />
        </div>

        {/* Tag filter chips — angular, cosmic-tech feel. Inactive chips use a
            muted accent (opacity + /20 border) so the active one stands out.
            Collapsed to 2 rows by default; toggle to expand. */}
        {allTags.length > 0 && (
          <div class="flex flex-col items-center" style="gap: var(--space-2);">
            <div
              id="blog-tag-grid"
              class="flex flex-wrap items-center justify-center overflow-hidden transition-[max-height] duration-300 ease-out"
              data-collapsed="true"
              style="gap: var(--space-2); max-height: 64px;"
            >
              <button
                type="button"
                data-tag=""
                class="blog-tag-chip text-xs font-mono transition-colors border bg-[var(--color-accent)]/15 text-[var(--color-accent)] border-[var(--color-accent)]/30"
                style="padding: 4px 10px; border-radius: 4px;"
              >
                All ({posts.length})
              </button>
              {allTags.map((tag) => (
                <button
                  type="button"
                  data-tag={tag}
                  class="blog-tag-chip text-xs font-mono transition-colors border hover:opacity-100"
                  style="padding: 4px 10px; border-radius: 4px; color: var(--color-accent); opacity: 0.6; border-color: var(--color-accent);"
                >
                  {tag} ({tagCounts[tag]})
                </button>
              ))}
            </div>
            <button
              id="blog-tag-toggle"
              type="button"
              class="text-xs font-mono opacity-60 hover:opacity-100 transition-opacity"
              style="padding: 2px 8px; color: var(--color-accent); background: transparent; border: 0; cursor: pointer;"
              aria-expanded="false"
              aria-controls="blog-tag-grid"
            >
              <span id="blog-tag-toggle-label">Show all tags ({allTags.length})</span>
              <span class="inline-block ml-1 transition-transform" id="blog-tag-toggle-icon">▾</span>
            </button>
          </div>
        )}

        {/* Active-filter indicator + result count */}
        <div class="flex items-center justify-center text-xs font-mono text-[var(--color-text-secondary)]" style="gap: var(--space-3);">
          <span id="blog-active-tag-row" class="hidden items-center" style="gap: var(--space-2);">
            <span>Filtered by</span>
            <span id="blog-active-tag" class="text-[var(--color-accent)]"></span>
            <button id="blog-clear-filter" type="button" class="underline hover:text-[var(--color-accent)]">clear</button>
          </span>
          <span id="blog-result-count" data-total={posts.length}>
            {posts.length} {posts.length === 1 ? 'post' : 'posts'}
          </span>
        </div>
      </div>

      {/* Posts grid */}
      <div id="blog-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 w-full" style="gap: var(--space-6);">
        {posts.map((post) => (
          <PostCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            updatedDate={post.data.updatedDate}
            heroImage={post.data.heroImage}
            tags={post.data.tags}
            slug={post.id.replace('en/', '')}
            lang="en"
          />
        ))}
      </div>

      {/* Empty state for client-side search */}
      <div
        id="blog-empty"
        class="hidden w-full text-center text-sm text-[var(--color-text-secondary)] font-mono"
        style="padding: var(--space-12) 0;"
      >
        No posts match that search. Try a different keyword?
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  // Client-side filtering for both text search and tag chips.
  // The site is statically generated, so we read query params from
  // window.location and filter the already-rendered grid in the DOM.
  type State = { q: string; tag: string };

  function initBlogList() {
    const input = document.getElementById('blog-search') as HTMLInputElement | null;
    const grid = document.getElementById('blog-grid');
    const empty = document.getElementById('blog-empty');
    const counter = document.getElementById('blog-result-count');
    const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.blog-tag-chip'));
    const activeTagRow = document.getElementById('blog-active-tag-row');
    const activeTagLabel = document.getElementById('blog-active-tag');
    const clearBtn = document.getElementById('blog-clear-filter');
    if (!input || !grid || !empty || !counter || !activeTagRow || !activeTagLabel) return;

    const cards = Array.from(grid.querySelectorAll<HTMLElement>('.post-card'));
    const totalLabel = counter.dataset.total ?? String(cards.length);

    const state: State = { q: '', tag: '' };

    const updateUrl = () => {
      const params = new URLSearchParams();
      if (state.q) params.set('q', state.q);
      if (state.tag) params.set('tag', state.tag);
      const qs = params.toString();
      const url = qs ? `?${qs}` : location.pathname;
      history.replaceState(null, '', url);
    };

    const updateChips = () => {
      chips.forEach((chip) => {
        const t = chip.dataset.tag ?? '';
        const isActive = t === state.tag;
        if (isActive) {
          chip.style.opacity = '1';
          chip.style.background = 'var(--color-accent)';
          chip.style.color = 'var(--color-bg)';
          chip.style.borderColor = 'var(--color-accent)';
        } else {
          chip.style.opacity = '0.6';
          chip.style.background = 'transparent';
          chip.style.color = 'var(--color-accent)';
          chip.style.borderColor = 'var(--color-accent)';
        }
      });
    };

    // Tag grid collapse / expand
    const tagGrid = document.getElementById('blog-tag-grid') as HTMLDivElement | null;
    const tagToggle = document.getElementById('blog-tag-toggle');
    const tagToggleLabel = document.getElementById('blog-tag-toggle-label');
    const tagToggleIcon = document.getElementById('blog-tag-toggle-icon');

    if (tagGrid && tagToggle && tagToggleLabel && tagToggleIcon) {
      const computeCollapsedHeight = () => {
        const chip = tagGrid.querySelector<HTMLElement>('.blog-tag-chip');
        if (!chip) return 64;
        const rowH = chip.offsetHeight + 8;
        return rowH * 2;
      };
      const computeExpandedHeight = () => tagGrid.scrollHeight;

      const updateToggleLabel = () => {
        const isCollapsed = tagGrid.dataset.collapsed !== 'false';
        if (isCollapsed) {
          tagToggleLabel.textContent = `Show all tags (${tagGrid.children.length})`;
          tagToggleIcon.textContent = '▾';
          tagToggle.setAttribute('aria-expanded', 'false');
        } else {
          tagToggleLabel.textContent = 'Collapse';
          tagToggleIcon.textContent = '▴';
          tagToggle.setAttribute('aria-expanded', 'true');
        }
      };

      const expandIfActiveHidden = () => {
        if (!state.tag) return;
        const activeChip = tagGrid.querySelector<HTMLElement>(
          `.blog-tag-chip[data-tag="${state.tag}"]`,
        );
        if (!activeChip) return;
        const gridRect = tagGrid.getBoundingClientRect();
        const chipRect = activeChip.getBoundingClientRect();
        if (chipRect.top >= gridRect.bottom || chipRect.bottom <= gridRect.top) {
          tagGrid.style.maxHeight = computeExpandedHeight() + 'px';
          tagGrid.dataset.collapsed = 'false';
          updateToggleLabel();
        }
      };

      tagToggle.addEventListener('click', () => {
        const isCollapsed = tagGrid.dataset.collapsed !== 'false';
        if (isCollapsed) {
          tagGrid.style.maxHeight = computeExpandedHeight() + 'px';
          tagGrid.dataset.collapsed = 'false';
        } else {
          tagGrid.style.maxHeight = computeCollapsedHeight() + 'px';
          tagGrid.dataset.collapsed = 'true';
        }
        updateToggleLabel();
      });

      window.addEventListener('resize', () => {
        if (tagGrid.dataset.collapsed === 'true') {
          tagGrid.style.maxHeight = computeCollapsedHeight() + 'px';
        } else {
          tagGrid.style.maxHeight = computeExpandedHeight() + 'px';
        }
      });

      chips.forEach((chip) => {
        chip.addEventListener('click', () =>
          setTimeout(expandIfActiveHidden, 0),
        );
      });

      updateToggleLabel();
    }

    const updateActiveTagLabel = () => {
      if (state.tag) {
        activeTagLabel.textContent = `#${state.tag}`;
        activeTagRow.classList.remove('hidden');
        activeTagRow.classList.add('flex');
      } else {
        activeTagRow.classList.add('hidden');
        activeTagRow.classList.remove('flex');
      }
    };

    const apply = () => {
      const q = state.q.toLowerCase();
      const tag = state.tag;
      let visible = 0;
      cards.forEach((card) => {
        const haystack = (card.dataset.search ?? '').toLowerCase();
        const tags = (card.dataset.tags ?? '').split(',').filter(Boolean);
        const matchText = !q || haystack.includes(q);
        const matchTag = !tag || tags.includes(tag);
        const match = matchText && matchTag;
        card.classList.toggle('hidden', !match);
        if (match) visible += 1;
      });
      empty.classList.toggle('hidden', visible !== 0);
      counter.textContent = q || tag
        ? `${visible} / ${totalLabel} posts`
        : `${totalLabel} posts`;
      updateChips();
      updateActiveTagLabel();
      updateUrl();
    };

    input.addEventListener('input', () => {
      state.q = input.value.trim();
      apply();
    });

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const t = chip.dataset.tag ?? '';
        state.tag = state.tag === t ? '' : t;
        apply();
      });
    });

    clearBtn?.addEventListener('click', () => {
      state.tag = '';
      apply();
    });

    // Pre-fill from query string
    const params = new URLSearchParams(location.search);
    const initialQ = params.get('q');
    const initialTag = params.get('tag') ?? '';
    if (initialQ) {
      input.value = initialQ;
      state.q = initialQ.trim();
    }
    if (initialTag) state.tag = initialTag;

    apply();
  }

  initBlogList();
  document.addEventListener('astro:page-load', initBlogList);
</script>

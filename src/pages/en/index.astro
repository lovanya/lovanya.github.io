---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/Blog/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((post) => post.id.startsWith('en/'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const siteTitle = "Jian Lin (Ziya) Blog - Jian Lin Frontend Architect Portfolio";
const siteDescription = "Jian Lin (also known as Ziya) frontend tech blog. 11 years of frontend architecture experience, focusing on enterprise web apps, micro-frontend, cross-platform development, performance optimization, and AI engineering.";
---

<BaseLayout title={siteTitle} description={siteDescription} lang="en">
  <!-- ItemList schema for latest posts on home page (en) -->
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      name: "Ziya's Latest Blog Posts",
      description: siteDescription,
      numberOfItems: posts.length,
      itemListElement: posts.slice(0, 6).map((post, idx) => ({
        '@type': 'ListItem',
        position: idx + 1,
        url: `https://lovanya.github.io/en/blog/${post.id.replace('en/', '')}`,
        name: post.data.title,
        description: post.data.description,
      })),
    })}
  />
  <div class="container" style="padding-top: var(--space-24); padding-bottom: var(--space-24);">
    <div class="flex flex-col" style="gap: var(--section-gap);">
      <!-- Hero section -->
      <section class="text-center relative">
        <div class="absolute inset-0 pointer-events-none overflow-hidden">
          <div class="absolute top-1/2 left-0 w-full h-px bg-gradient-to-r from-transparent via-[var(--color-accent)]/10 to-transparent"></div>
        </div>

        <div class="relative z-10 flex flex-col items-center" style="gap: var(--space-6);">
          <p class="font-mono text-xs text-[var(--color-accent)] tracking-widest opacity-60">{'WELCOME TO MY BLOG'}</p>
          <div class="flex flex-col items-center" style="gap: var(--space-4);">
            <h1 class="text-4xl md:text-5xl font-bold text-[var(--color-text)] tracking-tight">
              Hi, I'm <span class="text-[var(--color-accent)]">Ziya</span>
            </h1>
            <p class="text-base md:text-lg text-[var(--color-text-secondary)] max-w-2xl leading-relaxed font-mono">
              {siteDescription}
            </p>
          </div>
          <div class="flex flex-wrap justify-center" style="gap: var(--space-3);">
            <a href="/en/about" class="btn"><span>Learn More</span></a>
            <a href="/en/blog" class="btn btn-outline"><span>Read Blog</span></a>
          </div>
        </div>
      </section>

      <!-- Recent posts -->
      <section class="flex flex-col items-center w-full">
        <h2 class="section-title">Latest Posts</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 w-full" style="gap: var(--space-6);">
          {posts.slice(0, 6).map((post) => (
            <PostCard
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              updatedDate={post.data.updatedDate}
              heroImage={post.data.heroImage}
              slug={post.id.replace('en/', '')}
              lang="en"
            />
          ))}
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Comments from '../../components/Comments.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import RelatedPosts from '../../components/Blog/RelatedPosts.astro';
import { getCollection, render } from 'astro:content';
import { SITE_URL } from '../../consts';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts
    .filter((post) => !post.id.startsWith('en/'))
    .map((post) => ({
      params: { slug: post.id },
      props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const title = post.data.title;
const description = post.data.description;
const tags = post.data.tags || [];
const publishedTime = post.data.pubDate.toISOString();
const modifiedTime = post.data.updatedDate?.toISOString() || publishedTime;
const postUrl = new URL(`/blog/${post.id}`, SITE_URL).toString();

const breadcrumbs = [
  { label: '博客', href: '/blog' },
  { label: title, href: `/blog/${post.id}` },
];

const blogPosting = {
  headline: title,
  description,
  image: post.data.heroImage || '/images/avatar.png',
  datePublished: publishedTime,
  dateModified: modifiedTime,
  keywords: tags,
};
---

<BaseLayout
  title={title}
  description={description}
  lang="zh"
  articleType="article"
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  tags={tags}
  author="林健(紫牙)"
  image={post.data.heroImage || '/images/avatar.png'}
  breadcrumbs={breadcrumbs}
  blogPosting={blogPosting}
>
  <div class="container max-w-4xl" style="padding-top: var(--space-24); padding-bottom: var(--space-24);">
    <article class="flex flex-col w-full" style="gap: var(--title-gap);">
      <!-- Breadcrumb -->
      <Breadcrumb items={breadcrumbs} lang="zh" />

      <!-- Header -->
      <header class="flex flex-col w-full" style="gap: var(--space-6);">
        {post.data.heroImage && (
          <img
            src={post.data.heroImage}
            alt={post.data.title}
            loading="lazy"
            decoding="async"
            width="1024"
            height="256"
            class="w-full h-64 object-cover rounded-[var(--radius)]"
          />
        )}

        <div class="flex flex-col" style="gap: var(--space-4);">
          <h1 class="text-4xl font-bold text-[var(--color-text)] leading-tight">
            {post.data.title}
          </h1>

          <div class="flex flex-wrap items-center text-sm text-[var(--color-text-secondary)] font-mono" style="gap: var(--space-3) var(--space-4);">
            <time datetime={post.data.pubDate.toISOString()}>
              发布于 {post.data.pubDate.toLocaleDateString('zh-CN', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </time>
            {post.data.updatedDate && (
              <span>
                更新于 {post.data.updatedDate.toLocaleDateString('zh-CN', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </span>
            )}
            <span id="view-count" class="inline-flex items-center opacity-70" style="gap: var(--space-1); color: var(--color-accent);">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/>
                <circle cx="12" cy="12" r="3"/>
              </svg>
              <span id="view-count-text" class="text-[var(--color-text-secondary)]">—</span>
            </span>
          </div>
          <script>
            (async () => {
              const textEl = document.getElementById('view-count-text');
              if (!textEl) return;
              try {
                // Strip trailing slash so '/blog/foo/' becomes '/blog/foo'
                // (otherwise the URL gets '//' and browsers normalize to a
                // bad path, returning 404).
                const path = location.pathname.replace(/\/$/, '') || '/';
                const url = new URL(`https://purpletooth.goatcounter.com/counter${path}.json`);
                const res = await fetch(url.href);
                if (!res.ok) throw new Error(`${res.status} ${res.statusText}`);
                const data = await res.json();
                textEl.textContent = String(data.count || 0);
              } catch (e) {
                console.warn('[view-count] failed:', e);
                textEl.textContent = '0';
              }
            })();
          </script>

          {tags.length > 0 && (
            <div class="flex flex-wrap items-center" style="gap: var(--space-2);">
              <span class="text-xs text-[var(--color-text-secondary)] font-mono opacity-70">tags:</span>
              {tags.map((tag) => (
                <a
                  href={`/blog?tag=${encodeURIComponent(tag)}`}
                  class="text-xs font-mono px-2 py-1 rounded border border-[var(--color-border)] text-[var(--color-text-secondary)] hover:border-[var(--color-accent)]/40 hover:text-[var(--color-accent)] transition-colors"
                >
                  #{tag}
                </a>
              ))}
            </div>
          )}
        </div>
      </header>

      <!-- Content -->
      <div class="prose prose-lg max-w-none">
        <Content />
      </div>

      <!-- Share & Original Link -->
      <div class="flex flex-wrap items-center justify-between pt-6 border-t border-[var(--color-border)] text-sm text-[var(--color-text-secondary)] font-mono" style="gap: var(--space-4);">
        <a
          href={postUrl}
          class="hover:text-[var(--color-accent)] transition-colors"
          rel="canonical"
        >
          🔗 原文链接
        </a>
        <span class="opacity-50">分享让更多人看到</span>
      </div>

      <!-- Related Posts -->
      <RelatedPosts currentPost={post} lang="zh" limit={3} />

      <!-- Comments -->
      <Comments lang="zh" />
    </article>
  </div>
</BaseLayout>

<style is:global>
  .prose h1,
  .prose h2,
  .prose h3,
  .prose h4 {
    color: var(--color-accent);
  }
</style>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/Blog/PostCard.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((post) => !post.id.startsWith('en/'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const title = '紫牙的博客文章 - 前端架构 / 微前端 / AI 工程 | 林健';
const description = '紫牙(林健)的技术博客文章合集。涵盖前端架构设计、微前端、跨端开发、性能优化、React/Vue/Astro、TypeScript、LLM/RAG/Agent 等 AI 工程实践。';

const breadcrumbs = [{ label: '博客', href: '/blog' }];

// All unique tags across all posts (for the filter bar).
const allTags = Array.from(
  new Set(posts.flatMap((post) => post.data.tags ?? [])),
).sort();

// Tag counts so the filter bar can show "(N)" next to each tag.
const tagCounts = allTags.reduce<Record<string, number>>((acc, tag) => {
  acc[tag] = posts.filter((p) => p.data.tags?.includes(tag)).length;
  return acc;
}, {});
---

<BaseLayout title={title} description={description} lang="zh" breadcrumbs={breadcrumbs}>
  <!-- ItemList schema for blog post collection -->
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      name: title,
      description,
      numberOfItems: posts.length,
      itemListElement: posts.slice(0, 10).map((post, idx) => ({
        '@type': 'ListItem',
        position: idx + 1,
        url: `https://lovanya.github.io/blog/${post.id}`,
        name: post.data.title,
      })),
    })}
  />

  <div class="container" style="padding-top: var(--space-24); padding-bottom: var(--space-24);">
    <div class="flex flex-col items-center" style="gap: var(--title-gap);">
      <Breadcrumb items={breadcrumbs} lang="zh" />

      <header class="text-center flex flex-col items-center" style="gap: var(--space-3);">
        <h1 class="text-4xl font-bold text-[var(--color-text)]">博客</h1>
        <p class="text-[var(--color-text-secondary)]">{description}</p>
      </header>

      {/* Search + tag filter controls (pure client-side filtering) */}
      <div class="w-full flex flex-col items-center" style="gap: var(--space-4);">
        {/* Search input */}
        <div class="relative w-full max-w-xl">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-4 w-4 absolute left-3 top-1/2 -translate-y-1/2 text-[var(--color-accent)] pointer-events-none"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="7" />
            <path stroke-linecap="round" d="m20 20-3.5-3.5" />
          </svg>
          <input
            id="blog-search"
            type="search"
            placeholder="搜索博客标题、内容或标签…"
            aria-label="搜索博客"
            class="w-full bg-[var(--color-bg-secondary)] text-sm font-mono text-[var(--color-accent)] placeholder:text-[var(--color-text-secondary)] focus:outline-none focus:ring-1 focus:ring-[var(--color-accent)]/40"
            style="height: 32px; padding: 2px 12px 2px 36px; border-radius: 4px; border: 1px solid var(--color-accent-glow);"
          />
        </div>

        {/* Tag filter chips — angular, cosmic-tech feel. Inactive chips use a
            muted accent (opacity + /20 border) so the active one stands out. */}
        {allTags.length > 0 && (
          <div class="flex flex-wrap items-center justify-center" style="gap: var(--space-2);">
            <button
              type="button"
              data-tag=""
              class="blog-tag-chip text-xs font-mono transition-colors border bg-[var(--color-accent)]/15 text-[var(--color-accent)] border-[var(--color-accent)]/30"
              style="padding: 4px 10px; border-radius: 4px;"
            >
              全部 ({posts.length})
            </button>
            {allTags.map((tag) => (
              <button
                type="button"
                data-tag={tag}
                class="blog-tag-chip text-xs font-mono transition-colors border hover:opacity-100"
                style="padding: 4px 10px; border-radius: 4px; color: var(--color-accent); opacity: 0.6; border-color: var(--color-accent);"
              >
                {tag} ({tagCounts[tag]})
              </button>
            ))}
          </div>
        )}

        {/* Active-filter indicator + result count */}
        <div class="flex items-center justify-center text-xs font-mono text-[var(--color-text-secondary)]" style="gap: var(--space-3);">
          <span id="blog-active-tag-row" class="hidden items-center" style="gap: var(--space-2);">
            <span>已过滤标签</span>
            <span id="blog-active-tag" class="text-[var(--color-accent)]"></span>
            <button id="blog-clear-filter" type="button" class="underline hover:text-[var(--color-accent)]">清除</button>
          </span>
          <span id="blog-result-count" data-total={posts.length}>
            {posts.length} 篇文章
          </span>
        </div>
      </div>

      {/* Posts grid */}
      <div id="blog-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 w-full" style="gap: var(--space-6);">
        {posts.map((post) => (
          <PostCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            updatedDate={post.data.updatedDate}
            heroImage={post.data.heroImage}
            tags={post.data.tags}
            slug={post.id}
            lang="zh"
          />
        ))}
      </div>

      {/* Empty state for client-side search */}
      <div
        id="blog-empty"
        class="hidden w-full text-center text-sm text-[var(--color-text-secondary)] font-mono"
        style="padding: var(--space-12) 0;"
      >
        没有匹配的博客。试试别的关键词？
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  // Client-side filtering for both text search and tag chips.
  // The site is statically generated, so we read query params from
  // window.location and filter the already-rendered grid in the DOM.
  type State = { q: string; tag: string };

  function initBlogList() {
    const input = document.getElementById('blog-search') as HTMLInputElement | null;
    const grid = document.getElementById('blog-grid');
    const empty = document.getElementById('blog-empty');
    const counter = document.getElementById('blog-result-count');
    const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.blog-tag-chip'));
    const activeTagRow = document.getElementById('blog-active-tag-row');
    const activeTagLabel = document.getElementById('blog-active-tag');
    const clearBtn = document.getElementById('blog-clear-filter');
    if (!input || !grid || !empty || !counter || !activeTagRow || !activeTagLabel) return;

    const cards = Array.from(grid.querySelectorAll<HTMLElement>('.post-card'));
    const totalLabel = counter.dataset.total ?? String(cards.length);

    const state: State = { q: '', tag: '' };

    const updateUrl = () => {
      const params = new URLSearchParams();
      if (state.q) params.set('q', state.q);
      if (state.tag) params.set('tag', state.tag);
      const qs = params.toString();
      const url = qs ? `?${qs}` : location.pathname;
      history.replaceState(null, '', url);
    };

    const updateChips = () => {
      chips.forEach((chip) => {
        const t = chip.dataset.tag ?? '';
        const isActive = t === state.tag;
        if (isActive) {
          chip.style.opacity = '1';
          chip.style.background = 'var(--color-accent)';
          chip.style.color = 'var(--color-bg)';
          chip.style.borderColor = 'var(--color-accent)';
        } else {
          chip.style.opacity = '0.6';
          chip.style.background = 'transparent';
          chip.style.color = 'var(--color-accent)';
          chip.style.borderColor = 'var(--color-accent)';
        }
      });
    };

    const updateActiveTagLabel = () => {
      if (state.tag) {
        activeTagLabel.textContent = `#${state.tag}`;
        activeTagRow.classList.remove('hidden');
        activeTagRow.classList.add('flex');
      } else {
        activeTagRow.classList.add('hidden');
        activeTagRow.classList.remove('flex');
      }
    };

    const apply = () => {
      const q = state.q.toLowerCase();
      const tag = state.tag;
      let visible = 0;
      cards.forEach((card) => {
        const haystack = (card.dataset.search ?? '').toLowerCase();
        const tags = (card.dataset.tags ?? '').split(',').filter(Boolean);
        const matchText = !q || haystack.includes(q);
        const matchTag = !tag || tags.includes(tag);
        const match = matchText && matchTag;
        card.classList.toggle('hidden', !match);
        if (match) visible += 1;
      });
      empty.classList.toggle('hidden', visible !== 0);
      counter.textContent = q || tag
        ? `${visible} / ${totalLabel} 篇文章`
        : `${totalLabel} 篇文章`;
      updateChips();
      updateActiveTagLabel();
      updateUrl();
    };

    input.addEventListener('input', () => {
      state.q = input.value.trim();
      apply();
    });

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const t = chip.dataset.tag ?? '';
        state.tag = state.tag === t ? '' : t;
        apply();
      });
    });

    clearBtn?.addEventListener('click', () => {
      state.tag = '';
      apply();
    });

    // Pre-fill from query string
    const params = new URLSearchParams(location.search);
    const initialQ = params.get('q');
    const initialTag = params.get('tag') ?? '';
    if (initialQ) {
      input.value = initialQ;
      state.q = initialQ.trim();
    }
    if (initialTag) state.tag = initialTag;

    apply();
  }

  initBlogList();
  document.addEventListener('astro:page-load', initBlogList);
</script>

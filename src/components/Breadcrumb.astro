---
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
  lang?: 'zh' | 'en';
}

const { items, lang = 'zh' } = Astro.props;
const homeLabel = lang === 'zh' ? '首页' : 'Home';
---

<nav
  aria-label={lang === 'zh' ? '面包屑导航' : 'Breadcrumb'}
  class="flex flex-wrap items-center text-sm text-[var(--color-text-secondary)] font-mono"
  style="gap: var(--space-2);"
>
  <ol class="flex flex-wrap items-center list-none m-0 p-0" style="gap: var(--space-2);">
    <li class="flex items-center" style="gap: var(--space-2);">
      <a
        href={lang === 'en' ? '/en' : '/'}
        class="hover:text-[var(--color-accent)] transition-colors inline-flex items-center"
        aria-label={homeLabel}
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-3.5 w-3.5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"
          />
        </svg>
        <span class="sr-only">{homeLabel}</span>
      </a>
    </li>
    {
      items.map((item, idx) => (
        <li class="flex items-center" style="gap: var(--space-2);">
          <span class="opacity-50" aria-hidden="true">
            /
          </span>
          {item.href && idx < items.length - 1 ? (
            <a href={item.href} class="hover:text-[var(--color-accent)] transition-colors">
              {item.label}
            </a>
          ) : (
            <span class="text-[var(--color-text)]" aria-current="page">
              {item.label}
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>

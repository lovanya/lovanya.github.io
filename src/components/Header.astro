---
import ThemeToggle from './ThemeToggle.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  lang: 'zh' | 'en';
  currentPath: string;
}

const { lang, currentPath } = Astro.props;

const navItems = [
  { label: lang === 'zh' ? '首页' : 'Home', href: lang === 'zh' ? '/' : '/en/' },
  { label: lang === 'zh' ? '博客' : 'Blog', href: lang === 'zh' ? '/blog' : '/en/blog' },
  { label: lang === 'zh' ? '关于我' : 'About', href: lang === 'zh' ? '/about' : '/en/about' },
];

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  if (href === '/en/') return currentPath === '/en/' || currentPath === '/en';
  return currentPath.startsWith(href);
}
---

<header class="sticky top-0 z-50 backdrop-blur-md bg-[var(--color-bg)]/85 border-b border-[var(--color-border)]">
  <!-- Top accent line -->
  <div class="h-px w-full bg-gradient-to-r from-transparent via-[var(--color-accent)]/40 to-transparent"></div>

  <nav
    class="max-w-6xl mx-auto grid grid-cols-3 items-center"
    style="padding: 0 var(--space-8); height: 3.5rem; column-gap: var(--space-4);"
  >
    {/* Left: galaxy icon (replaces "&lt;紫牙 /&gt;" text logo) */}
    <a
      href={lang === 'zh' ? '/' : '/en/'}
      class="flex items-center justify-self-start text-[var(--color-accent)] hover:text-[var(--color-accent-hover)] transition-colors"
      aria-label={lang === 'zh' ? '返回首页' : 'Home'}
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 32 32"
        class="h-6 w-6"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        {/* Spiral galaxy: 3 arms around a glowing core */}
        <circle cx="16" cy="16" r="2" fill="currentColor" />
        <path d="M16 14 A6 6 0 0 1 22 16" />
        <path d="M18 16 A6 6 0 0 1 16 22" />
        <path d="M14 18 A6 6 0 0 1 10 16" />
        <path d="M16 10 A6 6 0 0 0 10 14" />
        {/* Star sparkles around the galaxy */}
        <path d="M27 5 L27.5 6.5 L29 7 L27.5 7.5 L27 9 L26.5 7.5 L25 7 L26.5 6.5 Z" fill="currentColor" stroke="none" />
        <path d="M5 25 L5.4 26 L6.4 26.4 L5.4 26.8 L5 27.8 L4.6 26.8 L3.6 26.4 L4.6 26 Z" fill="currentColor" stroke="none" />
        <circle cx="27" cy="22" r="0.8" fill="currentColor" stroke="none" />
        <circle cx="6" cy="9" r="0.6" fill="currentColor" stroke="none" />
      </svg>
    </a>

    {/* Center: nav links (truly centered thanks to grid 3-col) */}
    <ul class="hidden md:flex items-center justify-center" style="gap: var(--space-1);">
      {navItems.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={[
              'rounded text-xs font-mono transition-all',
              isActive(item.href)
                ? 'bg-[var(--color-accent)]/10 text-[var(--color-accent)] border border-[var(--color-accent)]/20'
                : 'text-[var(--color-text-secondary)] hover:text-[var(--color-text)] hover:bg-[var(--color-bg-secondary)]',
            ]}
            style="padding: var(--space-2) var(--space-4);"
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>

    {/* Right: language + theme */}
    <div class="flex items-center justify-self-end" style="gap: var(--space-2);">
      <div
        class="hidden md:flex items-center border-l border-[var(--color-border)]"
        style="gap: var(--space-2); padding-left: var(--space-2);"
      >
        <LanguageSwitcher lang={lang} currentPath={currentPath} />
        <ThemeToggle />
      </div>

      {/* Mobile menu button */}
      <button
        id="mobile-menu-btn"
        class="md:hidden rounded text-[var(--color-text-secondary)] hover:bg-[var(--color-bg-secondary)] transition-colors"
        style="padding: var(--space-2);"
        aria-label="Toggle menu"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-[var(--color-border)] bg-[var(--color-bg)]">
    <ul class="max-w-6xl mx-auto" style="padding: var(--space-4) var(--space-8);" >
      {navItems.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={[
              'block rounded text-xs font-mono transition-all',
              isActive(item.href)
                ? 'bg-[var(--color-accent)]/10 text-[var(--color-accent)] border border-[var(--color-accent)]/20'
                : 'text-[var(--color-text-secondary)] hover:text-[var(--color-text)] hover:bg-[var(--color-bg-secondary)]',
            ]}
            style="padding: var(--space-3) var(--space-4);"
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  menuBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });
</script>

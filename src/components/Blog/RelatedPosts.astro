---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';

interface Props {
  currentPost: CollectionEntry<'blog'>;
  lang?: 'zh' | 'en';
  limit?: number;
}

const { currentPost, lang = 'zh', limit = 5 } = Astro.props;
const currentId = currentPost.id;
const currentTags = currentPost.data.tags || [];

const allPosts = (await getCollection('blog'))
  .filter((post) => {
    if (lang === 'zh') return !post.id.startsWith('en/');
    return post.id.startsWith('en/');
  })
  .filter((post) => post.id !== currentId);

const scored = allPosts
  .map((post) => {
    const tags = post.data.tags || [];
    const sharedTags = tags.filter((t) => currentTags.includes(t)).length;
    const daysDiff =
      Math.abs(currentPost.data.pubDate.getTime() - post.data.pubDate.getTime()) /
      (1000 * 60 * 60 * 24);
    const score = sharedTags * 10 - Math.log(daysDiff + 1);
    return { post, score, sharedTags };
  })
  .filter(({ sharedTags }) => sharedTags > 0)
  .sort((a, b) => b.score - a.score)
  .slice(0, limit);

const relatedPosts = scored.map((s) => s.post);
const headingText = lang === 'zh' ? '相关文章' : 'Related Posts';
const noRelatedText = lang === 'zh' ? '暂无相关文章' : 'No related posts yet';
---

{
  relatedPosts.length > 0 && (
    <nav
      class="flex flex-col w-full mt-12 pt-8 border-t border-[var(--color-border)]"
      aria-label={headingText}
    >
      <h2 class="text-lg font-bold text-[var(--color-text)] font-mono" style="margin-bottom: var(--space-4);">
        {headingText}
      </h2>
      <ul class="flex flex-col" style="gap: var(--space-2);">
        {relatedPosts.map((post) => {
          const href = lang === 'en' ? `/en/blog/${post.id.replace('en/', '')}` : `/blog/${post.id}`;
          return (
            <li>
              <a
                href={href}
                class="inline-block text-[var(--color-accent)] hover:text-[var(--color-accent-hover)] hover:underline transition-colors font-mono"
                style="padding: var(--space-1) 0;"
              >
                → {post.data.title}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  )
}

{
  relatedPosts.length === 0 && (
    <div class="text-sm text-[var(--color-text-secondary)] font-mono opacity-50 mt-12 pt-8 border-t border-[var(--color-border)]">
      {noRelatedText}
    </div>
  )
}

---
interface Props {
  /** Optional class for the outer wrapper */
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<span
  class:list={['inline-flex items-center opacity-70', className]}
  style="gap: var(--space-1);"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="14"
    height="14"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    style="color: var(--color-accent);"
    aria-hidden="true"
  >
    <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
    <circle cx="12" cy="12" r="3"></circle>
  </svg>
  <span
    data-view-count
    style="color: var(--color-accent); font-variant-numeric: tabular-nums;"
  >0</span>
</span>

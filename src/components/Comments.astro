---
interface Props {
  lang: 'zh' | 'en';
}

const { lang } = Astro.props;
---

<div
  class="w-full flex flex-col"
  style="padding-top: var(--space-12); border-top: 1px solid var(--color-border); gap: var(--space-6);"
>
  <h3 class="text-xl font-bold text-[var(--color-text)]">
    {lang === 'zh' ? '评论' : 'Comments'}
  </h3>

  <div id="giscus-container">
    <script
      src="https://giscus.app/client.js"
      data-repo="lovanya/lovanya.github.io"
      data-repo-id="MDEwOlJlcG9zaXRvcnkxMDA2OTc1ODg="
      data-category="Announcements"
      data-category-id="DIC_kwDOBgCF9M4DAZ67"
      data-mapping="pathname"
      data-strict="0"
      data-reactions-enabled="1"
      data-emit-metadata="0"
      data-input-position="top"
      data-theme="preferred_color_scheme"
      data-lang={lang === 'zh' ? 'zh-CN' : 'en'}
      data-loading="lazy"
      crossorigin="anonymous"
      async
    ></script>
  </div>

  <noscript>
    <p class="text-[var(--color-text-secondary)]">
      {lang === 'zh'
        ? '请启用 JavaScript 以查看评论。'
        : 'Please enable JavaScript to view comments.'}
    </p>
  </noscript>
</div>

<script>
  // Handle theme changes for Giscus
  function updateGiscusTheme() {
    const isDark = document.documentElement.classList.contains('dark');
    const giscusFrame = document.querySelector('iframe.giscus-frame') as HTMLIFrameElement;
    
    if (giscusFrame) {
      giscusFrame.contentWindow?.postMessage(
        { giscus: { setConfig: { theme: isDark ? 'dark' : 'light' } } },
        'https://giscus.app'
      );
    }
  }

  // Listen for theme changes
  const observer = new MutationObserver((mutations) => {
    mutations.forEach((mutation) => {
      if (mutation.attributeName === 'class') {
        updateGiscusTheme();
      }
    });
  });

  observer.observe(document.documentElement, { attributes: true });

  // Initial update
  document.addEventListener('DOMContentLoaded', () => {
    setTimeout(updateGiscusTheme, 1000);
  });
</script>

<style>
  #giscus-container {
    min-height: 100px;
  }
</style>

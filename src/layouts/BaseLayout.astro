---
import '../styles/global.css';
import Header from '../components/Header.astro';
import ChatBot from '../components/ChatBot/ChatBot';
import AIPanel from '../components/AI/AIPanel.tsx';
import SelectionToolbar from '../components/AI/SelectionToolbar.tsx';
import { SITE_TITLE, SITE_DESCRIPTION, SITE_KEYWORDS, SITE_URL, AUTHOR } from '../consts';

interface Props {
  title: string;
  description?: string;
  lang?: 'zh' | 'en';
  image?: string;
  articleType?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  tags?: string[];
  canonical?: string;
  breadcrumbs?: { label: string; href: string }[];
  blogPosting?: {
    headline: string;
    description: string;
    image?: string;
    datePublished: string;
    dateModified?: string;
    keywords?: string[];
    wordCount?: number;
  };
}

const {
  title,
  description,
  lang = 'zh',
  image = '/images/avatar.png',
  articleType = 'website',
  publishedTime,
  modifiedTime,
  author,
  tags = [],
  canonical,
  breadcrumbs,
  blogPosting,
} = Astro.props;

const currentPath = Astro.url.pathname;
const currentUrl = new URL(currentPath, SITE_URL).toString();
const canonicalUrl = canonical || currentUrl;
const finalDescription = description || SITE_DESCRIPTION[lang];
const siteShortTitle = lang === 'zh' ? '林健(紫牙)的博客' : 'Jian Lin (Ziya) Blog';
// Only append site title if it's not already in the title
const finalTitle = title.includes(siteShortTitle) || title.includes('林健') || title.includes('紫牙') || title.includes('Jian Lin') || title.includes('Ziya')
  ? title
  : `${title} | ${siteShortTitle}`;
const imageUrl = image.startsWith('http') ? image : new URL(image, SITE_URL).toString();
const keywords = SITE_KEYWORDS[lang] + (tags.length ? ',' + tags.join(',') : '');
const authorName = author || `${AUTHOR.name}(${AUTHOR.alternateName})`;

// Person 结构化数据 - 提升作者权威性
const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: AUTHOR.name,
  alternateName: [AUTHOR.alternateName, AUTHOR.englishName, 'Ziya'],
  jobTitle: AUTHOR.jobTitle,
  description: lang === 'zh' ? AUTHOR.description : AUTHOR.englishDescription,
  url: SITE_URL,
  email: AUTHOR.email,
  sameAs: [
    AUTHOR.github,
  ],
  knowsAbout: [
    'Frontend Architecture',
    'Micro-Frontend',
    'Performance Optimization',
    'React',
    'Vue',
    'TypeScript',
    'Astro',
    'AI Engineering',
    'LLM',
    'RAG',
  ],
};

// Website 结构化数据
const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_TITLE[lang],
  alternateName: [
    '林健的博客',
    '林健的简历',
    '林健的简历博客',
    '紫牙的博客',
    '紫牙博客',
    '紫牙的简历',
    'Ziya Blog',
    'Ziya Resume',
    'Jian Lin Blog',
    'Jian Lin Resume',
    'Jian Lin (Ziya) Blog',
  ],
  url: SITE_URL,
  inLanguage: ['zh-CN', 'en-US'],
  description: finalDescription,
  author: {
    '@type': 'Person',
    name: AUTHOR.name,
    alternateName: [AUTHOR.alternateName, '林健', 'Jian Lin', 'Ziya'],
  },
  publisher: {
    '@type': 'Person',
    name: AUTHOR.name,
    alternateName: AUTHOR.alternateName,
    url: SITE_URL,
  },
  about: {
    '@type': 'Person',
    name: AUTHOR.name,
    alternateName: AUTHOR.alternateName,
    jobTitle: AUTHOR.jobTitle,
  },
  potentialAction: {
    '@type': 'SearchAction',
    target: `${SITE_URL}/blog?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};
---
<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary SEO -->
    <title>{finalTitle}</title>
    <meta name="description" content={finalDescription} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content={authorName} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="googlebot" content="index, follow" />
    <meta name="baiduspider" content="index, follow" />

    <!-- Google Search Console -->
    <meta name="google-site-verification" content="boq6EifEbE0xGqc8Ulz8n11pyQNwGcYm1fGWdkvBsdY" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="zh-CN" href={`${SITE_URL}${currentPath}`} />
    <link rel="alternate" hreflang="en" href={`${SITE_URL}/en${currentPath === '/' ? '' : currentPath}`} />
    <link rel="alternate" hreflang="x-default" href={`${SITE_URL}${currentPath}`} />

    <!-- Favicon & App Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32-next.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16x16-next.png" />
    <link rel="apple-touch-icon" href="/images/apple-touch-icon-next.png" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={articleType} />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'zh' ? 'en_US' : 'zh_CN'} />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:site_name" content={SITE_TITLE[lang]} />
    <meta property="og:title" content={finalTitle} />
    <meta property="og:description" content={finalDescription} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={authorName} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {author && <meta property="article:author" content={author} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={finalTitle} />
    <meta name="twitter:description" content={finalDescription} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={authorName} />
    <meta name="twitter:creator" content="@lovanya" />
    <meta name="twitter:site" content="@lovanya" />

    <!-- 百度站长验证 (替换为你的验证码) -->
    <!-- <meta name="baidu-site-verification" content="your-baidu-code" /> -->

    <!-- 360 站长验证 -->
    <!-- <meta name="360-site-verification" content="your-360-code" /> -->

    <!-- 搜狗站长验证 -->
    <!-- <meta name="sogou_site_verification" content="your-sogou-code" /> -->

    <!-- Bing Webmaster Center -->
    <meta name="msvalidate.01" content="013407D95497B29B0A8AF9AF1043D7C4" />

    <!-- Theme & Appearance -->
    <meta name="theme-color" content="#0a0e1a" />
    <meta name="color-scheme" content="dark light" />

    <!-- Structured Data: Person -->
    <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />

    <!-- Structured Data: WebSite -->
    <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />

    <!-- Structured Data: BlogPosting (for blog articles) -->
    {
      blogPosting && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify({
            '@context': 'https://schema.org',
            '@type': 'BlogPosting',
            headline: blogPosting.headline,
            description: blogPosting.description,
            image: blogPosting.image
              ? blogPosting.image.startsWith('http')
                ? blogPosting.image
                : new URL(blogPosting.image, SITE_URL).toString()
              : imageUrl,
            datePublished: blogPosting.datePublished,
            dateModified: blogPosting.dateModified || blogPosting.datePublished,
            author: {
              '@type': 'Person',
              name: AUTHOR.name,
              alternateName: AUTHOR.alternateName,
              url: SITE_URL,
            },
            publisher: {
              '@type': 'Person',
              name: AUTHOR.name,
              alternateName: AUTHOR.alternateName,
              url: SITE_URL,
              logo: {
                '@type': 'ImageObject',
                url: new URL('/images/avatar.png', SITE_URL).toString(),
              },
            },
            mainEntityOfPage: {
              '@type': 'WebPage',
              '@id': currentUrl,
            },
            keywords: blogPosting.keywords?.join(',') || tags.join(','),
            wordCount: blogPosting.wordCount,
            inLanguage: lang === 'zh' ? 'zh-CN' : 'en-US',
            url: currentUrl,
          })}
        />
      )
    }

    <!-- Structured Data: BreadcrumbList -->
    {
      breadcrumbs && breadcrumbs.length > 0 && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify({
            '@context': 'https://schema.org',
            '@type': 'BreadcrumbList',
            itemListElement: breadcrumbs.map((crumb, idx) => ({
              '@type': 'ListItem',
              position: idx + 1,
              name: crumb.label,
              item: new URL(crumb.href, SITE_URL).toString(),
            })),
          })}
        />
      )
    }

    <!-- Preload JetBrains Mono for cold tech aesthetic -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;500;600;700&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;500;600;700&display=swap"
      />
    </noscript>

    <!-- DNS prefetch for external resources -->
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />

    <!-- RSS Feed -->
    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE[lang]} href="/rss.xml" />

    <script is:inline>
      (function() {
        const savedTheme = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (savedTheme === 'dark' || (!savedTheme && prefersDark)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>

    <!-- GoatCounter analytics -->
    <script data-goatcounter="https://purpletooth.goatcounter.com/count"
            async src="//gc.zgo.at/count.js"></script>
  </head>
  <body class="min-h-screen flex flex-col bg-[var(--color-bg)] text-[var(--color-text)] transition-colors duration-300">
    <!-- Scan line overlay -->
    <div class="scan-line"></div>

    <Header lang={lang} currentPath={currentPath} />
    <main class="flex-1">
      <slot />
    </main>
    <footer
      class="text-center text-[var(--color-text-secondary)] border-t border-[var(--color-border)] bg-[var(--color-bg-secondary)] relative overflow-hidden"
      style="padding-top: var(--space-12); padding-bottom: var(--space-12);"
    >
      <!-- Footer circuit decoration -->
      <div
        class="absolute inset-0 opacity-5"
        style="background-image: linear-gradient(rgba(0,229,255,0.3) 1px, transparent 1px), linear-gradient(90deg, rgba(0,229,255,0.3) 1px, transparent 1px); background-size: 30px 30px;"
      ></div>
      <div class="container relative z-10 flex flex-col items-center" style="gap: var(--space-2);">
        <p class="font-mono text-sm text-center">
          &copy; {new Date().getFullYear()}
          <a href="/" class="text-[var(--color-accent)] hover:underline" title={`${AUTHOR.name} - ${AUTHOR.jobTitle}`}>
            {lang === 'zh' ? `${AUTHOR.name}(${AUTHOR.alternateName})` : `${AUTHOR.englishName} (${AUTHOR.alternateName})`}
          </a>
          . {lang === 'zh' ? '版权所有' : 'All Rights Reserved'}
        </p>
        <p class="text-xs opacity-50 font-mono text-center">
          {lang === 'zh'
            ? `// ${AUTHOR.name}的博客 | ${AUTHOR.alternateName}的博客 | ${AUTHOR.name}(${AUTHOR.alternateName})前端架构师 | 由 Astro 驱动`
            : `// ${AUTHOR.englishName} Blog | ${AUTHOR.alternateName} Blog | Frontend Architect | Powered by Astro`
          }
        </p>
      </div>
    </footer>

    <!-- Cold tech cursor (vanilla JS, no React) -->
    <script>
      import '../scripts/cursor';
    </script>

    <!-- Scroll reveal -->
    <script>
      (function() {
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.target.classList.contains('visible')) return;
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
            }
          });
        }, { threshold: 0.1 });

        document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
      })();
    </script>
    <ChatBot client:load />

    <!-- AI Workbench: 就地展开面板 + 全局选区工具条（复用 ChatBot 的 Gemini 配置） -->
    <AIPanel client:load />
    <SelectionToolbar client:load />
    <script>
      // 文章内容装饰：绑定 [data-ai-*] 按钮 + 给 <pre> 注入 CodeAsk 按钮
      (function () {
        if (typeof window === 'undefined') return;
        const dispatchAiOpen = (detail) => {
          window.dispatchEvent(new CustomEvent('ai:open', { detail }));
        };
        const bindAiAskButtons = () => {
          document.querySelectorAll('.ai-ask-btn[data-ai-template][data-ai-payload]').forEach((btn) => {
            if (btn.dataset.bound === '1') return;
            btn.dataset.bound = '1';
            btn.addEventListener('click', (e) => {
              e.preventDefault();
              e.stopPropagation();
              const rect = btn.getBoundingClientRect();
              const template = btn.dataset.aiTemplate;
              const payload = btn.dataset.aiPayload || '';
              if (!payload) return;
              dispatchAiOpen({
                template,
                payload,
                anchor: { x: rect.left + rect.width / 2, y: rect.bottom + window.scrollY },
              });
            });
          });
        };
        const decorateCodeBlocks = () => {
          document.querySelectorAll('article pre, .prose pre, .post-content pre').forEach((pre) => {
            if (pre.dataset.aiDecorated === '1') return;
            pre.dataset.aiDecorated = '1';
            const cs = window.getComputedStyle(pre);
            if (cs.position === 'static') pre.style.position = 'relative';
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'ai-code-ask-btn';
            btn.setAttribute('aria-label', '让 AI 解析这段代码');
            btn.title = '让 AI 解析这段代码';
            btn.innerHTML = '<svg viewBox="0 0 100 100" aria-hidden="true" style="width:24px;height:24px;display:block"><line x1="50" y1="12" x2="50" y2="26" stroke="currentColor" stroke-width="4" stroke-linecap="round"/><circle cx="50" cy="9" r="5" fill="currentColor" stroke="none"/><rect x="16" y="26" width="68" height="54" rx="14" fill="none" stroke="currentColor" stroke-width="4"/><circle class="ai-eye-left" cx="36" cy="48" r="6" fill="currentColor" stroke="none"/><circle class="ai-eye-right" cx="64" cy="48" r="6" fill="currentColor" stroke="none"/><path class="ai-mouth-smile" d="M 30 66 Q 50 76 70 66" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round"/><ellipse class="ai-mouth-open" cx="50" cy="68" rx="10" ry="7" fill="currentColor" opacity="0"/></svg>';
            btn.dataset.bound = '1';
            btn.addEventListener('mouseenter', () => {
              const svg = btn.querySelector('svg');
              if (!svg) return;
              const le = svg.querySelector('.ai-eye-left');
              const re = svg.querySelector('.ai-eye-right');
              const ms = svg.querySelector('.ai-mouth-smile');
              const mo = svg.querySelector('.ai-mouth-open');
              if (le) le.setAttribute('cx', '38');
              if (re) re.setAttribute('cx', '62');
              if (ms) ms.setAttribute('opacity', '0');
              if (mo) mo.setAttribute('opacity', '1');
            });
            btn.addEventListener('mouseleave', () => {
              const svg = btn.querySelector('svg');
              if (!svg) return;
              const le = svg.querySelector('.ai-eye-left');
              const re = svg.querySelector('.ai-eye-right');
              const ms = svg.querySelector('.ai-mouth-smile');
              const mo = svg.querySelector('.ai-mouth-open');
              if (le) le.setAttribute('cx', '36');
              if (re) re.setAttribute('cx', '64');
              if (ms) ms.setAttribute('opacity', '1');
              if (mo) mo.setAttribute('opacity', '0');
            });
            btn.addEventListener('click', (e) => {
              e.preventDefault();
              e.stopPropagation();
              const code = pre.querySelector('code')?.textContent || pre.textContent || '';
              const truncated = code.length > 8000 ? code.slice(0, 8000) + '\n…（截断）' : code;
              const rect = pre.getBoundingClientRect();
              dispatchAiOpen({
                template: 'codeExplain',
                payload: truncated,
                anchor: { x: rect.left + rect.width / 2, y: rect.bottom + window.scrollY },
              });
            });
            pre.appendChild(btn);
          });
        };
        const decorateAll = () => {
          bindAiAskButtons();
          decorateCodeBlocks();
        };
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', decorateAll);
        } else {
          decorateAll();
        }
        window.addEventListener('astro:page-load', decorateAll);
        if (typeof MutationObserver !== 'undefined') {
          const obs = new MutationObserver(() => decorateAll());
          obs.observe(document.body, { childList: true, subtree: true });
        }
      })();
    </script>
    <style is:global>
      @keyframes aipanel-dot {
        0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; }
        40% { transform: scale(1); opacity: 1; }
      }
      @keyframes aipanel-blink {
        0%, 50% { opacity: 1; }
        51%, 100% { opacity: 0; }
      }
      @keyframes selection-toolbar-in {
        from { opacity: 0; transform: translateY(4px); }
        to { opacity: 1; transform: translateY(0); }
      }
      .ai-code-ask-btn {
        position: absolute;
        top: 8px;
        right: 8px;
        width: 32px;
        height: 32px;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: none;
        background: transparent;
        color: var(--color-accent);
        cursor: pointer;
        opacity: 0;
        transition: opacity 0.2s, transform 0.15s, filter 0.2s;
        z-index: 10;
      }
      .ai-code-ask-btn .ai-eye-left,
      .ai-code-ask-btn .ai-eye-right {
        transition: cx 0.25s cubic-bezier(0.4, 0, 0.2, 1);
      }
      .ai-code-ask-btn .ai-mouth-smile,
      .ai-code-ask-btn .ai-mouth-open {
        transition: opacity 0.2s ease;
      }
      pre:hover .ai-code-ask-btn,
      .ai-code-ask-btn:focus-visible {
        opacity: 0.85;
      }
      .ai-code-ask-btn:hover {
        opacity: 1 !important;
        transform: scale(1.12);
        filter: drop-shadow(0 0 8px var(--color-accent-glow));
      }
      .ai-mermaid-ask-btn:hover {
        opacity: 1 !important;
        transform: scale(1.12);
        filter: drop-shadow(0 0 8px var(--color-accent-glow));
        background: var(--color-accent-dim) !important;
      }
    </style>

    <!-- GoatCounter visit count -->
    <script>
      (function() {
        var t = setInterval(function() {
          if (window.goatcounter && window.goatcounter.get_data) {
            clearInterval(t);
            var path = window.goatcounter.get_data()['p'];
            var r = new XMLHttpRequest();
            r.onreadystatechange = function() {
              if (r.readyState !== 4) return;
              // GoatCounter returns 200 for paths with hits and 404 for paths
              // without, but the 404 body still contains a valid count JSON
              // (count: 0). Parse on any readyState 4, since Safari/WebKit
              // may not fire the 'load' event for non-2xx responses.
              try {
                var data = JSON.parse(r.responseText);
                if (data) {
                  document.querySelectorAll('.view-count').forEach(function(el) {
                    el.textContent = data.count;
                  });

                  document.querySelectorAll('.user-count').forEach(function(el) {
                    el.textContent = data.count_unique;
                  });
                }
              } catch (e) {}
            };
            r.open('GET', 'https://purpletooth.goatcounter.com/counter' + path + '.json');
            r.send();
          }
        }, 100);
      })();
    </script>
  </body>
</html>

<style>
  .scroll-smooth {
    scroll-behavior: smooth;
  }
</style>
